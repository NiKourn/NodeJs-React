{
  "name": "monorepo-app",
  "private": true,
  "workspaces": [
    "nodejs-backend",
    "react-frontend"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:*",
    "dev:backend": "npm --workspace nodejs-backend run dev",
    "dev:frontend": "npm --workspace react-frontend run dev",
    "build": "npm-run-all build:*",
    "build:backend": "npm --workspace nodejs-backend run build",
    "build:frontend": "npm --workspace react-frontend run build",
    "start:backend": "npm --workspace nodejs-backend run start",
    "preview:frontend": "npm --workspace react-frontend run preview",
    "tscheck": "tsc -b --noEmit"
  },
  "devDependencies": {
  "@types/node": "^24.5.2",
  "npm-run-all": "^4.1.5",
  "prettier-plugin-tailwindcss": "^0.6.14",
  "typescript": "^5.9.2",
  "socket.io": "^4.8.1",
  "@tailwindcss/postcss": "^4.1.13"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.1"
}
